# SeguraMente - Variaveis de Ambiente

# ============================================
# PROVEDOR LLM
# ============================================
# Opcoes: template | openai | openai-compatible | gemini
LLM_PROVIDER=template

# ============================================
# OPENAI
# ============================================
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================
# GOOGLE GEMINI
# ============================================
GEMINI_API_KEY=

# ============================================
# CONFIGURACAO GERAL DO LLM
# ============================================
# Modelo padrao (muda por provider):
#   openai: gpt-4.1-mini
#   gemini: gemini-3.6-flash
SEGURAMENTE_LLM_MODEL=
SEGURAMENTE_LLM_TIMEOUT=30

# ============================================
# BANCO DE DADOS
# ============================================
# Caminho para o SQLite (opcional, padrao: data/seguramente.db)
# SEGURAMENTE_DB_PATH=data/seguramente.db

# ============================================
# EMAIL (ENVIO REAL)
# ============================================
# Configuracao SMTP para envio real de email.
# Se nao configurado, o sistema usa simulacao como fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================
# WEBHOOK
# ============================================
# Porta do servidor FastAPI (opcional, padrao: 8000)
# WEBHOOK_PORT=8000
